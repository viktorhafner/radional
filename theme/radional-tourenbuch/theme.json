{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "color": "#FFFFFF", "name": "Weiß", "slug": "base" },
				{ "color": "#2A2522", "name": "Dunkelbraun", "slug": "contrast" },
				{ "color": "#B4492A", "name": "Terrakotta", "slug": "accent-1" },
				{ "color": "#FAF6F2", "name": "Sand", "slug": "accent-2" },
				{ "color": "#3E7357", "name": "Waldgrün", "slug": "accent-3" },
				{ "color": "#6E645E", "name": "Steingrau", "slug": "accent-4" },
				{ "color": "#EFE8E1", "name": "Sand dunkel", "slug": "accent-5" },
				{ "color": "#EDE6E0", "name": "Linie", "slug": "accent-6" },
				{ "color": "#D9CFC7", "name": "Fußtext", "slug": "fusstext" }
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1200px"
		},
		"typography": {
			"dropCap": true,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Montserrat",
					"slug": "montserrat",
					"fontFamily": "Montserrat, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/montserrat.woff2" ]
						},
						{
							"fontFamily": "Montserrat",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/montserrat-italic.woff2" ]
						}
					]
				},
				{
					"name": "Cormorant Garamond",
					"slug": "cormorant",
					"fontFamily": "\"Cormorant Garamond\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/cormorant-garamond.woff2" ]
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "italic",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/cormorant-garamond-italic.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "name": "Klein", "slug": "small", "size": "0.875rem", "fluid": false },
				{ "name": "Normal", "slug": "medium", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "name": "Groß", "slug": "large", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "name": "Sehr groß", "slug": "x-large", "size": "2.6rem", "fluid": { "min": "2rem", "max": "2.875rem" } },
				{ "name": "Riesig", "slug": "xx-large", "size": "4.25rem", "fluid": { "min": "2.75rem", "max": "4.5rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|montserrat",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.75",
			"letterSpacing": "0"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|cormorant",
					"fontWeight": "600",
					"lineHeight": "1.1",
					"letterSpacing": "0"
				},
				"color": { "text": "var:preset|color|contrast" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1.02" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "1.75rem", "lineHeight": "1.15" } },
			"h4": { "typography": { "fontSize": "1.4rem" } },
			"link": {
				"color": { "text": "var:preset|color|accent-1" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var:preset|color|contrast" }
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent-1",
					"text": "var:preset|color|base"
				},
				"border": { "radius": "0" },
				"spacing": { "padding": { "top": "0.95rem", "bottom": "0.95rem", "left": "1.6rem", "right": "1.6rem" } },
				"typography": {
					"fontFamily": "var:preset|font-family|montserrat",
					"fontSize": "0.8125rem",
					"fontWeight": "600",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				}
			},
			"caption": {
				"typography": { "fontSize": "var:preset|font-size|small" },
				"color": { "text": "var:preset|color|accent-4" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "0.8125rem",
					"fontWeight": "600",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						"color": { "text": "var:preset|color|contrast" },
						":hover": { "color": { "text": "var:preset|color|accent-1" } }
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						"color": { "text": "var:preset|color|contrast" },
						":hover": { "color": { "text": "var:preset|color|accent-1" } }
					}
				}
			},
			"core/post-excerpt": {
				"typography": { "lineHeight": "1.65" },
				"color": { "text": "#5E5550" }
			},
			"core/quote": {
				"border": {
					"left": { "color": "var:preset|color|accent-1", "width": "3px", "style": "solid" }
				},
				"spacing": { "padding": { "left": "1.75rem" } },
				"typography": {
					"fontFamily": "var:preset|font-family|cormorant",
					"fontStyle": "italic",
					"fontSize": "1.875rem",
					"lineHeight": "1.3"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var:preset|font-family|cormorant",
					"fontStyle": "italic",
					"fontSize": "2rem",
					"lineHeight": "1.3"
				},
				"border": {
					"top": { "color": "var:preset|color|accent-1", "width": "2px", "style": "solid" },
					"bottom": { "color": "var:preset|color|accent-1", "width": "2px", "style": "solid" }
				}
			},
			"core/separator": {
				"color": { "text": "var:preset|color|accent-6" }
			}
		}
	},
	"templateParts": [
		{ "area": "header", "name": "header", "title": "Kopf" },
		{ "area": "footer", "name": "footer", "title": "Fuß" }
	],
	"customTemplates": []
}
